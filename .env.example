# Copy to .env.local (or your platform's secret manager) and fill in real
# values. Never commit an actual .env file with real secrets — .env* is
# already gitignored except this example file.

# PostgreSQL connection string. Without this, the app falls back to
# in-memory storage (data lost on restart) — see README "Environment Variables".
DATABASE_URL=postgres://user:password@localhost:5432/hadeelos

# Set to "true" if your Postgres provider requires TLS (most managed hosts do).
DATABASE_SSL=false

# Base64-encoded 32-byte AES-256 key for encrypting Calendar/Gmail tokens at
# rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth 2.0 Client credentials — only needed for real Google
# Calendar/Gmail connections via /api/calendar/oauth/exchange and
# /api/gmail/oauth/exchange. The mock-provider "Connect (mock)" buttons in
# the frontend work without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Port the backend listens on.
PORT=3000
